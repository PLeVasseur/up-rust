{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uprotocol:native-deployment:provisional:1",
  "title": "Provisional independently provisioned endpoint and route expectations",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "format_version", "provisional", "endpoints", "routes", "content_sha256"],
  "properties": {
    "schema": {"const": "uprotocol.native-deployment.provisional"},
    "format_version": {"const": 1}, "provisional": {"const": true},
    "content_sha256": {"$ref": "urn:uprotocol:native-inventory:provisional:1#/$defs/sha256"},
    "endpoints": {"type": "array", "minItems": 2, "maxItems": 4096, "items": {"$ref": "#/$defs/endpoint"}},
    "routes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/route"}}
  },
  "$defs": {
    "endpoint": {"type": "object", "additionalProperties": false,
      "required": ["id", "agreement_path", "content_sha256", "target", "domain", "generation"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "agreement_path": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "urn:uprotocol:native-inventory:provisional:1#/$defs/sha256"},
        "target": {"$ref": "urn:uprotocol:native-inventory:provisional:1#/$defs/target"},
        "domain": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }},
    "route": {"type": "object", "additionalProperties": false, "required": ["id", "endpoints"],
      "properties": {"id": {"type": "string", "minLength": 1},
        "endpoints": {"type": "array", "minItems": 2, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  },
  "$comment": "Semantic admission resolves every relative locator beneath profile_root, checks expected full identities and complete route membership, and rejects self-substitution or unequal route agreement contents. This is configuration agreement, not remote attestation."
}
