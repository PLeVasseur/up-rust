{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uprotocol:native-inventory:provisional:1",
  "title": "Provisional target-qualified native inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "provisional", "descriptor_version", "token_derivation_version", "target", "types", "content_sha256"],
  "properties": {
    "schema": {"const": "uprotocol.native-inventory.provisional"},
    "format_version": {"const": 1},
    "provisional": {"const": true},
    "descriptor_version": {"const": 2},
    "token_derivation_version": {"const": 2},
    "target": {"$ref": "#/$defs/target"},
    "types": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/descriptor"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["triple", "endianness", "pointer_width"],
      "properties": {
        "triple": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+$"},
        "endianness": {"enum": ["little", "big"]},
        "pointer_width": {"enum": [32, 64]}
      }
    },
    "type_key": {
      "type": "object", "additionalProperties": false, "required": ["name", "revision"],
      "properties": {"name": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0, "maximum": 4294967295}}
    },
    "descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "canonical_descriptor_base64", "descriptor_sha256", "native_type_token"],
      "properties": {
        "key": {"$ref": "#/$defs/type_key"},
        "canonical_descriptor_base64": {"type": "string", "minLength": 1, "maxLength": 1398104, "contentEncoding": "base64"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "native_type_token": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  },
  "$comment": "Semantic validation checks canonical descriptor bytes, exact target/name/revision, full hash, token derivation, uniqueness and ordering. This schema does not attest a remote build."
}
